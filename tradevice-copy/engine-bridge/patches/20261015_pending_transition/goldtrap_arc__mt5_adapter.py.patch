+        if (live.order_type,live.price,live.stoplimit)!=(before.order_type,before.price,before.stoplimit):
+            raise ArcPendingTransitionWait('Owned stop-limit activated during TP update')
+        if live.tp!=before.tp:raise ArcSafetyError('Pending protection changed concurrently')
 
