+    def _pending_for_tp(self,before,entry):
+        self.guard_identity()
+        snap=self.snapshot()
+        live=next((o for o in snap.orders if o.ticket==before.ticket),None)
+        if live is None:
+            proof=self._prove_intent(dict(operation='PENDING_MODIFY',cycle_id=self.cycle(before),
+                layer=before.layer,side=before.side.value,target_ticket=before.ticket,
+                expected_comment=before.comment,expected_volume=before.volume,request={}))
+            if proof['status']=='EFFECT':raise ArcPendingTransitionWait('Owned pending filled during TP update')
+            raise ArcSafetyError('Pending absent without exact fill proof')
+        equal=lambda a,b:math.isclose(a,b,rel_tol=0,abs_tol=1e-9)
+        activation=(before.order_type,live.order_type) in ((6,2),(7,3))
+        if (not self.is_owned(live) or (live.comment,live.side,live.layer,live.magic)!=(before.comment,before.side,before.layer,before.magic)
+                or not equal(live.volume,before.volume) or not equal(live.entry_price,entry)
+                or (live.type_time,live.expiration,live.sl)!=(before.type_time,before.expiration,before.sl)
+                or (live.order_type!=before.order_type and not activation)
+                or (not activation and (live.price,live.stoplimit)!=(before.price,before.stoplimit))):
+            raise ArcSafetyError('Pending topology changed outside exact activation')
+        return live
+
+    def _assert_pending_unchanged(self,before):
