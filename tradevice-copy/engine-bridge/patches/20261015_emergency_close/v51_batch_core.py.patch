+def broker_batch_stop(rows,history):
+    """Only the exact, resolved 10013 activation race can defer a rejection."""
+    for row in rows:
+        if row.get('resolution')=='PARTIAL_EFFECT':return True
+        if row.get('classification')!='DEFINITIVE_REJECT':continue
+        rid=row.get('request_id');related=[r for r in history if r.get('request_id')==rid]
+        safe=(row.get('retcode')==10013 and bool(rid)
+              and any(r.get('event')=='BROKER_REQUEST_INTENT' and r.get('operation')=='PENDING_MODIFY' for r in related)
+              and any(r.get('resolution')=='PROVEN_NO_EFFECT_AFTER_REJECT' for r in related)
+              and any(r.get('event')=='PENDING_TRANSITION_DEFERRED' for r in related))
+        if not safe:return True
+    return False
 
