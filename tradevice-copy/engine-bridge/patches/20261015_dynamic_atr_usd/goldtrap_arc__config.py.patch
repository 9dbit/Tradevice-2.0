+
+
+# Per-cycle immutable configuration stays hash-bound; the current closed-M1
+# observation is a separate runtime value and is durably recorded by the engine.
+_ATR_TARGETS={}
+def dynamic_atr_tp(cfg):
+    proof=execution_config_proof(cfg)
+    return bool(proof and proof.get('tp_basis')=='ATR_CURRENT_USD')
+def adaptive_projection_gates_disabled(cfg):
+    proof=execution_config_proof(cfg)
+    return bool(proof and proof['settings']['protocol']=='V51_DYNAMIC_ATR_USD_20261015')
+def current_atr_target(cfg):
+    row=_ATR_TARGETS.get(id(cfg))
+    return copy.deepcopy(row[1]) if row and row[0]() is cfg else None
+def update_atr_target(cfg,atr,candle_time):
+    if not dynamic_atr_tp(cfg):raise ArcSafetyError('NOT_DYNAMIC_ATR_CONFIG')
+    if (type(atr) not in (int,float) or not math.isfinite(atr) or atr<=0 or atr>1e6
+            or type(candle_time) not in (int,float) or not math.isfinite(candle_time) or candle_time<0):
+        raise ArcSafetyError('DYNAMIC_ATR_OBSERVATION_INVALID')
+    old=current_atr_target(cfg)
+    if old and (candle_time<old['candle_time'] or (candle_time==old['candle_time'] and atr!=old['atr'])):
+        raise ArcSafetyError('DYNAMIC_ATR_CANDLE_CHANGED')
+    multiplier=1 if execution_config_proof(cfg)['settings']['tpMode']=='ATR_1' else 2
+    row=dict(atr=atr,candle_time=candle_time,target_usd=atr*multiplier,multiplier=multiplier)
+    key=id(cfg);_ATR_TARGETS[key]=(weakref.ref(cfg,lambda ref:_ATR_TARGETS.pop(key,None)),row)
+    return copy.deepcopy(row)
+def basket_tp_usd(cfg):
+    row=current_atr_target(cfg)
+    return row['target_usd'] if row else cfg.basket_profit_target_usd
