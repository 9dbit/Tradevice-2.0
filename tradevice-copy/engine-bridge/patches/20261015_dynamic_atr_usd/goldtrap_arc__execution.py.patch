+    def refresh_atr_tp(self):
+        if not dynamic_atr_tp(self.cfg):return True
+        try:
+            bars=self.adapter.recent_closed_bars(self.cfg.atr_period+1)
+            validate_closed_m1(bars,time(),allow_boundary_wait=True)
+            atr=atr_at(bars,len(bars)-1,self.cfg.atr_period)
+            row=update_atr_target(self.cfg,atr,bars[-1].time)
+        except (ArcSafetyError,ValueError,TypeError):
+            if not self.state.get('atr_tp_unavailable'):
+                self.state['atr_tp_unavailable']=True;self.save()
+                self.ledger.append('ATR_TP_UNAVAILABLE',cycle_id=self.state.get('cycle_id'))
+            return False
+        if row!=self.state.get('atr_tp_current') or self.state.get('atr_tp_unavailable'):
+            self.state.update(atr_tp_current=row,atr_tp_unavailable=False);self.save()
+            self.ledger.append('ATR_TP_UPDATED',cycle_id=self.state.get('cycle_id'),**row)
+        return True
+
+    def sync_atr_pending_tp(self,snap):
+        if not dynamic_atr_tp(self.cfg):return
+        positions,orders=self.owned(snap)
+        key='initial_fixed_plan' if self.fixed_arming=='PREARM_BOTH' else 'active_fixed_plan'
+        plan=self.state.get(key,[])
+        for side in (Side.BUY,Side.SELL):
+            models=self.adapter.models([p for p in positions if p.side==side])
+            for row in sorted((r for r in plan if r['side']==side.value),key=lambda r:r['layer']):
+                order=next((o for o in orders if o.side==side and o.layer==row['layer']),None)
+                if not order:continue
+                models.append(Position(row['layer'],side,row['lot'],row['price'],0,'ATR_PENDING'))
+                target=quantized_target(models,self.cfg)
+                if abs(order.tp-target)>self.cfg.tick_size/2:
+                    self.ledger.append('ATR_PENDING_TP_INTENT',cycle_id=self.state['cycle_id'],ticket=order.ticket,
+                        original_entry=row['price'],target=target,target_usd=basket_tp_usd(self.cfg))
+                    self.adapter.modify_pending(order,row['price'],target)
+                    # Never resend an ambiguous modify or recreate a missing pending.
+                    fresh=self.adapter.snapshot();self.owned(fresh)
+                    actual=next((o for o in fresh.orders if o.ticket==order.ticket),None)
+                    if actual is None or abs(actual.tp-target)>self.cfg.tick_size/2:
+                        raise ArcSafetyError('ATR pending TP verification changed broker topology')
+                row['tp']=target;self.save()
 
