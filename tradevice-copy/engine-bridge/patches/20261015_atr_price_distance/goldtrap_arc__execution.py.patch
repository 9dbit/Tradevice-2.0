+        if len(types)!=1 or not types<={0,1}:return False
+        side=Side.BUY if types=={0} else Side.SELL
+        for pid in ids:
+            opened=sum(float(d.volume) for d in entries if int(d.position_id)==pid)
+            closed=sum(float(d.volume) for d in exits if int(d.position_id)==pid)
+            if opened<=0 or not math.isclose(opened,closed,rel_tol=0,abs_tol=1e-9):return False
