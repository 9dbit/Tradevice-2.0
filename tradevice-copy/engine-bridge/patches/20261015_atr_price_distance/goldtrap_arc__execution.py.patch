+        entries=[d for d in life.get('entry_deals',()) if members is None or int(d.position_id) in members]
+        exits=[d for d in life.get('exit_deals',()) if members is None or int(d.position_id) in members]
+        ids={int(d.position_id) for d in entries}
+        if not ids or (members is not None and ids!=set(members)):return False
+        if {int(d.position_id) for d in exits}!=ids:return False
